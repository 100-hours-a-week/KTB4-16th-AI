APP_ENV=local
INTERNAL_TOKEN=dev-internal-token

# 로컬 직접 실행 시. docker compose에서는 compose 파일 값이 우선
DATABASE_URL=postgresql+asyncpg://muro:muro@localhost:5432/muro_ai

# fake: 키 없이 가짜 벡터로 동작 / real: 실제 외부 API 호출
AI_CLIENT_MODE=fake

# V1 필요 키 3개: ANTHROPIC_API_KEY, OPENAI_API_KEY, REPLICATE_API_TOKEN
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

OPENAI_API_KEY=
TEXT_EMBEDDING_MODEL=text-embedding-3-small
TEXT_EMBEDDING_DIM=1536

# CLIP — Replicate openai/clip (clip-vit-large-patch14)
REPLICATE_API_TOKEN=
CLIP_MODEL=openai/clip
CLIP_EMBEDDING_DIM=768
