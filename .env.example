APP_ENV=local
INTERNAL_TOKEN=dev-internal-token

# 로컬 직접 실행 시. docker compose에서는 compose 파일 값이 우선
DATABASE_URL=postgresql+asyncpg://muro:muro@localhost:5432/muro_ai

# fake: 키 없이 가짜 벡터로 동작 / real: 실제 외부 API 호출
AI_CLIENT_MODE=fake

# 필요 키: ANTHROPIC_API_KEY, REPLICATE_API_TOKEN (OPENAI_API_KEY는 TEXT_EMBEDDING_PROVIDER=openai일 때만)
# LLM 두 갈래: knowledge(무드 묘사·문항 생성) / general(리라이팅·요약·답변)
# V1은 둘 다 anthropic, V2에서 general만 local(RunPod)로 전환
LLM_KNOWLEDGE_PROVIDER=anthropic
LLM_GENERAL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# 기능1·3 장면 문장은 RunPod의 Gemma가 쓴다 (LLM_SCENE_PROVIDER=local이 기본, anthropic이면 Claude)
# LOCAL_LLM_URL은 /v1/chat/completions까지 포함한 전체 주소
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=gemma-3-12b
LOCAL_LLM_API_KEY=
# 리포트 요약(AI 리캡)도 같은 Gemma가 먼저 쓰고, 서버가 꺼져 있거나 실패하면 Claude(LLM_FALLBACK_MODEL)로
# 넘긴다 (LLM_REPORT_PROVIDER=local이 기본, anthropic이면 Claude(LLM_MODEL)만 쓴다)
LLM_REPORT_PROVIDER=local
LLM_FALLBACK_MODEL=claude-haiku-5-5
# 기억 검색 답변 앞머리 문장(MEMORY_ANSWER_LLM_ENABLED=true가 기본, false면 템플릿)도 같은 Gemma가 먼저 쓰고, 서버가
# 꺼져 있는 등 호출이 실패하면 Claude(LLM_FALLBACK_MODEL)로 넘긴다 (LLM_HEADLINE_PROVIDER=local이 기본,
# anthropic이면 Claude만). 시간 초과·검증 실패는 Claude로 넘기지 않고 템플릿 문장으로 대신한다
LLM_HEADLINE_PROVIDER=local
MEMORY_ANSWER_LLM_ENABLED=true

# LangSmith 추적 — 기억 검색의 단계별 시간·오류를 본다 (app/observability.py)
# 서버가 시작할 때 이 파일의 LANGSMITH_*·LANGCHAIN_* 값만 환경변수로 옮긴다(다른 값은 옮기지 않는다).
# 이미 환경변수로 준 값(쉘·compose·서버)이 있으면 그 값이 우선이다. 추적을 안 쓰면 false로 둔다
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=muro-memory-search
# 질문 원문·코멘트가 LangSmith로 올라가지 않게 입력·출력 내용을 숨긴다. 추적을 켜도 true로 둘 것
# (켜 두면 화면에는 단계별 시간·오류만 보이고 내용은 안 보인다)
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# 계정이 EU 지역이면 주석을 풀어 쓴다
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# 텍스트 임베딩: kure(기본, KURE-v1 ONNX를 컨테이너 안 embedding 서비스로 서빙) / openai(되돌리기용, 1536차원)
# kure는 KURE_MODEL_DIR(기본 /app/models/kure)에 모델 파일이 있어야 한다. fake 모드는 파일 없이 동작한다
TEXT_EMBEDDING_PROVIDER=kure
# 아래 셋은 TEXT_EMBEDDING_PROVIDER=openai일 때만 쓴다
OPENAI_API_KEY=
TEXT_EMBEDDING_MODEL=text-embedding-3-small
TEXT_EMBEDDING_DIM=1536

# CLIP — Replicate openai/clip (clip-vit-large-patch14)
REPLICATE_API_TOKEN=

# Spotify — developer.spotify.com 대시보드의 앱 Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 플레이리스트 저장(B안, 뮤로 팀 계정 1개)용. scripts/spotify_service_account_setup.py로 1회 발급
SPOTIFY_SERVICE_REFRESH_TOKEN=
CLIP_MODEL=openai/clip
CLIP_EMBEDDING_DIM=768

# 워커 실행 여부 — 블루그린 대기 VM은 false (CD가 트래픽 전환 때 운영 VM만 true로 바꿈)
RUN_WORKER=true
